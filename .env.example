# Names used by the server-side Firebase configuration.
# The hosted app reads these from Base44 Dashboard → Secrets via base44:runtime.
# Do not put service-account credentials or production secrets in this file.

# Firebase web app configuration
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# reCAPTCHA Enterprise site key registered for the Firebase web app
FIREBASE_APP_CHECK_SITE_KEY=

# Optional JSON alternative to the individual Firebase values above
# FIREBASE_WEB_CONFIG={"apiKey":"","authDomain":"","projectId":"","storageBucket":"","messagingSenderId":"","appId":"","appCheckSiteKey":""}

# Development/preview only. Keep unset in production.
FIREBASE_APPCHECK_DEBUG_TOKEN=
