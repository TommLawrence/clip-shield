# ClipShield — server-side app secrets (Base44: `base44 secrets set`)
#
# These are read at request time by src/lib/firebase-config.server.js and
# src/lib/server-fns.js via `secrets.get()`. Only public Firebase project
# identifiers reach the browser; no service account or admin credential is
# used or required. Never commit real values — this file documents names only.

# Option A: one JSON blob from the Firebase console (overrides the fields below)
FIREBASE_WEB_CONFIG=

# Option B: individual fields
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# App Check
FIREBASE_APP_CHECK_SITE_KEY=
# Local App Check debugging only — never set in production
FIREBASE_APPCHECK_DEBUG_TOKEN=

# Convex
CONVEX_DEPLOYMENT_URL=
